{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "functions": {
    "api/benchmark.js": {
      "maxDuration": 60
    },
    "api/defaults.js": {
      "maxDuration": 60,
      "includeFiles": [

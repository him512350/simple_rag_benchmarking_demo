# Server-only. Never prefix credentials with VITE_.
OPENROUTER_API_KEY=
# Optional server-only completion base; omit for https://openrouter.ai/api/v1
OPENROUTER_BASE_URL=https://projteam-openrouter-proxy-790311698684.asia-east1.run.app/v1

# Vercel adds these when a PUBLIC Blob store is connected (OIDC authentication).
BLOB_STORE_ID=
BLOB_WEBHOOK_PUBLIC_KEY=

# Optional local development fallback when no OIDC store connection is used.
# Presigned client uploads still need BLOB_WEBHOOK_PUBLIC_KEY.
BLOB_READ_WRITE_TOKEN=
# Optional: populated by `vercel env pull` for local OIDC; the SDK refreshes it.
VERCEL_OIDC_TOKEN=

# Server-only admin credentials; use a long random session secret (at least 32 chars).
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
